{
  "buildCommand": "bash scripts/build.sh",
  "outputDirectory": "artifacts/image-review/dist/public",
  "functions": {
    "api/index.mjs": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/workforce/api/(.*)", "destination": "/api" },
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/workforce", "destination": "/workforce/index.html" },
    { "source": "/workforce/(.*)", "destination": "/workforce/index.html" },
    { "source": "/((?!api|workforce).*)", "destination": "/index.html" }
  ]
}
