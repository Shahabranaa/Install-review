{
  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "cd ../.. && BASE_PATH=/ pnpm --filter @workspace/workforce run build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://install-review-api-server.vercel.app/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
